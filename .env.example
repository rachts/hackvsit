# ============================================
# VITAMEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env.local for Next.js or backend/.env for Node backend

# Database Provider Selection
# Options: "supabase" | "firebase" | "mongodb" | "mysql" | "mock"
NEXT_PUBLIC_DB_PROVIDER=mongodb

# Database Connection (MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vitamend?retryWrites=true&w=majority
MONGODB_DB_NAME=vitamend

# Supabase Credentials (if using NEXT_PUBLIC_DB_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Firebase Credentials (if using NEXT_PUBLIC_DB_PROVIDER=firebase)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# NextAuth / JWT Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Delivery (Resend / SMTP)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# Python OCR Microservice URL
OCR_API_URL=http://127.0.0.1:8000

# Security & CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,https://vitamend.vercel.app
PORT=5005
NODE_ENV=development

# API and Logging Configuration
NEXT_PUBLIC_API_URL=http://localhost:5005
NEXT_PUBLIC_OFFICIAL_EMAIL=vitamend.org@gmail.com
LOG_LEVEL=info

# MySQL Connection (if using NEXT_PUBLIC_DB_PROVIDER=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=vitamend
